{
  "name": "@haulq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify API. Serves app.haulq.ai's backend from the same Render service.",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --experimental-strip-types src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../../.env --test --test-concurrency=1 --experimental-strip-types \"src/**/*.test.ts\"",
    "validate-here-etas": "node --env-file-if-exists=../../.env --experimental-strip-types src/scripts/validate-here-etas.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.6",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@haulq/contracts": "workspace:*",
    "@haulq/db": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "pino": "^10.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
