{
  "name": "@haulq/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 0 schema, migrations and the tenant-scoped client. The only package that talks to Postgres.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "keypair": "node --experimental-strip-types src/scripts/generate-credential-keypair.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 --experimental-strip-types \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.729.0",
    "drizzle-orm": "^0.38.0",
    "libsodium-wrappers": "^0.7.15",
    "postgres": "^3.4.5",
    "@haulq/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.0"
  }
}
