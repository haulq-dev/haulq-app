# Local only. Real values come from Doppler (`doppler run -- pnpm dev`).

# --- database -------------------------------------------------------------
DATABASE_URL=postgres://haulq:haulq@localhost:5432/haulq

# --- api ------------------------------------------------------------------
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# --- auth -----------------------------------------------------------------
# `dev` trusts request headers and refuses to run in production.
# `clerk` requires CLERK_SECRET_KEY. See docs/clerk-setup.md.
AUTH_PROVIDER=dev
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From the Clerk dashboard's webhook endpoint. Without it /webhooks/clerk
# returns 503 and accepts nothing.
CLERK_WEBHOOK_SECRET=

# --- object storage (Cloudflare R2) --------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=haulq-documents

# --- carrier credential envelope encryption ------------------------------
# libsodium sealed-box keypair. board_credentials stores a pointer, never a secret.
# Generate with `generateCredentialKeypair()` in packages/db/src/credential-crypto.ts.
CREDENTIAL_ENCRYPTION_PUBLIC_KEY=
CREDENTIAL_ENCRYPTION_PRIVATE_KEY=

# --- Motive (Phase 2b's ELD) -----------------------------------------------
# OAuth app credentials from developer.gomotive.com. Both this and the
# encryption keypair above have to be set for /v1/integrations/motive/* to
# accept a connection — see apps/api/src/routes/integrations.ts.
MOTIVE_CLIENT_ID=
MOTIVE_CLIENT_SECRET=
# Must exactly match the redirect URI registered with the Motive OAuth app.
MOTIVE_REDIRECT_URI=http://localhost:3001/v1/integrations/motive/callback
# Poll interval in ms for syncing every connected org's vehicle positions.
# 0 disables it, same reasoning as OUTBOX_POLL_MS: a poller that starts
# itself syncs real Motive data (and burns its rate limit) in every test
# and every local `pnpm dev`.
MOTIVE_SYNC_POLL_MS=0

# --- local object storage -------------------------------------------------
# Ignored once R2 is configured.
STORAGE_DIR=/tmp/haulq-storage

# --- HaulQ Docs: OCR and the model pass ------------------------------------
# Both optional. Without them the pipeline still reads every digital PDF for
# free; these only widen what it can read beyond that, one after the other.
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
# For documents classification and the rules still decline after OCR. See
# apps/api/src/documents/model-reader.ts for why it can only report text it
# can point at verbatim on the page.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- email ----------------------------------------------------------------
# Optional. With no token the mailer logs what it would have sent, so the
# invite flow is walkable with no Postmark account.
POSTMARK_SERVER_TOKEN=
# Must be on a Postmark-verified domain or every send is rejected.
EMAIL_FROM=hello@haulq.ai
# Inbound email intake for HaulQ Docs. Both optional together; without them
# /v1/webhooks/postmark-inbound returns 503 and accepts nothing. Set in the
# Postmark inbound stream's webhook URL as https://user:password@api.haulq.ai/v1/webhooks/postmark-inbound
POSTMARK_INBOUND_USER=
POSTMARK_INBOUND_PASSWORD=

# --- outbox consumer ------------------------------------------------------
# Poll interval in ms for the in-process outbox consumer. 0 disables it.
# Off by default: a poller that starts itself drains rows a test was about to
# assert on. Render sets this; nothing else does.
OUTBOX_POLL_MS=0

# --- web ------------------------------------------------------------------
VITE_API_URL=http://localhost:3001
